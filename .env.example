# Copy to .env.local (git-ignored) at the project root. NEXT_PUBLIC_* are baked in at `next build`/`next dev` start: restart after editing.
# Where the API server (server/) lives. Unset => the public forms fall back honestly (review -> WhatsApp link, contact -> "could not send").
NEXT_PUBLIC_API_BASE=http://localhost:8000
# Same server, used by /admin for writes. Unset => /admin is read-only.
NEXT_PUBLIC_ADMIN_API=http://localhost:8000
# Admin upload limit shown to the owner (MB). Keep equal to MAX_UPLOAD_MB in server/.env
NEXT_PUBLIC_MAX_UPLOAD_MB=100

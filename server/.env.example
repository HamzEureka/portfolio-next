# Copy to server/.env (git-ignored) and edit. Loaded by `npm run server`.
ADMIN_TOKEN=change-me-to-a-long-random-string
PORT=8000
HOST=127.0.0.1
# Origins of the website (exact match, comma separated). Add your real domain in production.
ALLOWED_ORIGINS=http://localhost:3000
# Public base of THIS server, used in upload URLs. Leave empty locally.
PUBLIC_URL=
# Where content.json, uploads/, reviews.json, messages.json live. MUST be the repo's data/ folder so the site sees the edits.
# DATA_DIR=
MAX_UPLOAD_MB=100
# Set to 1 only behind a reverse proxy that sets X-Forwarded-For / X-Forwarded-Proto.
TRUST_PROXY=0

# Command run by the admin "publish" button ("off" disables it)
# PUBLISH_CMD=node scripts/publish.mjs

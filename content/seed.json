    "process": [
      {
        "id": "step1",
        "title": {
          "ar": "فهم الهدف والبريف",
          "en": "Understanding the goal & brief"
        },
        "text": {
          "ar": "جلسة قصيرة نتفق فيها على الجمهور، المدة المطلوبة، والمرجعيات البصرية قبل أي خطوة تقنية.",
          "en": "A short session to agree on the audience, the required length, and the visual references before any technical step."
        }
      },
      {
        "id": "step2",
        "title": {
          "ar": "التجميع الأولي (Assembly)",
          "en": "Rough assembly"
        },
        "text": {
          "ar": "ترتيب أفضل اللقطات في تسلسل خام يوضح شكل القصة، من غير التركيز على التفاصيل الدقيقة بعد.",
          "en": "Arranging the best shots in a raw sequence that shows the shape of the story, without worrying about fine details yet."
        }
      },
      {
        "id": "step3",
        "title": {
          "ar": "القص النهائي والإيقاع",
          "en": "Final cut & rhythm"
        },
        "text": {
          "ar": "ضبط التوقيت، الانتقالات، والموسيقى بحيث يبقى الإيقاع خادم للرسالة، مش مجرد تتابع لقطات.",
          "en": "Tuning the timing, transitions, and music so the rhythm serves the message instead of being just a string of shots."
        }
      },
      {
        "id": "step4",
        "title": {
          "ar": "الألوان والصوت",
          "en": "Color & sound"
        },
        "text": {
          "ar": "تصحيح لوني يوحّد شكل المشاهد، ومزج صوتي يخلي الحوار والموسيقى واضحين ومتوازنين.",
          "en": "Color grading that unifies the look of the scenes, and a sound mix that keeps dialogue and music clear and balanced."
        }
      },
      {
        "id": "step5",
        "title": {
          "ar": "المراجعة والتسليم",
          "en": "Review & delivery"
        },
        "text": {
          "ar": "جولة أو جولتين ملاحظات، وبعدين تسليم الملفات بالصيغ والمقاسات المناسبة لكل منصة.",
          "en": "One or two rounds of notes, then delivery of the files in the right formats and sizes for each platform."
        }
      }
    ],
